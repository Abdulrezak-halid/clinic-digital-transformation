{
  "name": "@clinic/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --testPathPatterns=unit",
    "test:integration": "jest --runInBand --testPathPatterns=integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "node dist/bootstrap.js",
    "recover": "node dist/recover.js",
    "maintenance": "node dist/maintenance.js"
  },
  "dependencies": {
    "@clinic/contracts": "*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "otpauth": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/express": "^5.0.5",
    "@types/cookie-parser": "^1.4.10"
  }
}
